<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
          http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <!--
        IKE typed-marker family default alias manifest, shipped as a
        classified attachment on ike-base-parent.

        Coordinates: network.ike:ike-base-parent:<v>:aliases:zip

        Contents: META-INF/ike/version-aliases.yaml — the same
        manifest that ike-version-management-extension bundles
        internally. Published here as data so external tooling
        (lint, IDE plugins, documentation generators, alternate
        extensions) can read it without depending on the extension
        jar.

        See IKE-Network/ike-issues#470, #473, #525.
    -->
    <id>aliases</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>src/main/aliases</directory>
            <outputDirectory>META-INF/ike</outputDirectory>
            <useDefaultExcludes>false</useDefaultExcludes>
        </fileSet>
    </fileSets>
</assembly>
