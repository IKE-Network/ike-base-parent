<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Base Parent — Tier 0
  ════════════════════════

  The foundation parent for the IKE Network: the apex of the parent
  inheritance forest, inherited by ike-tooling, ike-docs, and
  ike-platform. It carries shared publishing metadata; GPG signing
  and Maven Central (JReleaser) configuration are added next, and
  build conventions migrate in incrementally.

  See the design note dev-parent-tier-architecture (ike-lab-documents)
  for the tier model and the staged migration plan.
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <groupId>network.ike</groupId>
    <artifactId>ike-base-parent</artifactId>
    <version>1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Base Parent</name>
    <description>
        Tier 0 foundation parent for the IKE Network — the apex of the
        parent inheritance forest, inherited by ike-tooling, ike-docs,
        and ike-platform. Carries shared publishing metadata, GPG
        signing, and Maven Central publishing configuration.
    </description>
    <url>https://ike.network/ike-base-parent/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <developers>
        <developer>
            <name>IKE Network Team</name>
            <email>dev@ike.network</email>
            <organization>IKE Network</organization>
            <organizationUrl>https://ike.network</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-base-parent.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-base-parent.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-base-parent</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <!-- Releases go to Maven Central via JReleaser (jreleaser-maven-plugin
             config below). This snapshotRepository is only for SNAPSHOT
             deploys to the internal Nexus. -->
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>https://nexus.tinkar.org/repository/ike-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <jreleaser-maven-plugin.version>1.24.0</jreleaser-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <!-- JReleaser — Maven Central upload. Invoked as an explicit goal
                 (mvn jreleaser:deploy), never bound to a lifecycle phase. This
                 <configuration> is inherited by every IKE artifact that
                 inherits ike-base-parent.

                 Release is two-step:
                   1. mvn deploy -PsignArtifacts \
                        -DaltDeploymentRepository=local::file://target/staging-deploy
                      writes signed artifacts to target/staging-deploy
                   2. mvn jreleaser:deploy
                      uploads that bundle to the Central Portal
                 Credentials: JRELEASER_DEPLOY_MAVEN_MAVENCENTRAL_USERNAME /
                 _PASSWORD env vars, supplied via `op run`. -->
            <plugin>
                <groupId>org.jreleaser</groupId>
                <artifactId>jreleaser-maven-plugin</artifactId>
                <version>${jreleaser-maven-plugin.version}</version>
                <configuration>
                    <jreleaser>
                        <!-- Artifacts are signed by maven-gpg-plugin (Bouncy
                             Castle) during the staging deploy; JReleaser does
                             not re-sign. -->
                        <signing>
                            <active>NEVER</active>
                        </signing>
                        <deploy>
                            <maven>
                                <mavenCentral>
                                    <sonatype>
                                        <active>RELEASE</active>
                                        <url>https://central.sonatype.com/api/v1/publisher</url>
                                        <stagingRepositories>
                                            <stagingRepository>target/staging-deploy</stagingRepository>
                                        </stagingRepositories>
                                        <applyMavenCentralRules>true</applyMavenCentralRules>
                                        <!-- Artifacts arrive pre-signed (BC);
                                             do not let the Central rules
                                             re-sign them. -->
                                        <sign>false</sign>
                                    </sonatype>
                                </mavenCentral>
                            </maven>
                        </deploy>
                    </jreleaser>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Artifact signing for release / staging deploys. Bouncy Castle
             signer — parallel-safe, no gpg-agent contention. Reads the key
             from gpg.keyFilePath (settings.xml) and the passphrase from
             MAVEN_GPG_PASSPHRASE (supplied via `op run`). Activate with
             -PsignArtifacts on the staging deploy. -->
        <profile>
            <id>signArtifacts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
