<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Base Parent — Tier 0
  ════════════════════════

  The foundation parent for the IKE Network: the apex of the parent
  inheritance forest, inherited by ike-tooling, ike-docs, and
  ike-platform. It carries shared publishing metadata; GPG signing
  and Maven Central (JReleaser) configuration are added next, and
  build conventions migrate in incrementally.

  See the design note dev-parent-tier-architecture (ike-lab-documents)
  for the tier model and the staged migration plan.
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <groupId>network.ike</groupId>
    <artifactId>ike-base-parent</artifactId>
    <version>14</version>
    <packaging>pom</packaging>

    <name>IKE Base Parent</name>
    <description>
        Tier 0 foundation parent for the IKE Network — the apex of the
        parent inheritance forest, inherited by ike-tooling, ike-docs,
        and ike-platform. Carries shared publishing metadata, GPG
        signing, and Maven Central publishing configuration.
    </description>
    <url>https://ike.network/ike-base-parent/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <developers>
        <developer>
            <name>IKE Network Team</name>
            <email>dev@ike.network</email>
            <organization>IKE Network</organization>
            <organizationUrl>https://ike.network</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-base-parent.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-base-parent.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-base-parent</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <!-- Releases go to Maven Central via JReleaser (jreleaser-maven-plugin
             config below). This <repository> is the internal Nexus mirror
             — used by `mvn deploy -P release` as a parallel publication
             target. The Central upload runs through JReleaser separately. -->
        <repository>
            <id>ike-staging</id>
            <url>https://nexus.tinkar.org/repository/ike-staging/</url>
        </repository>
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>https://nexus.tinkar.org/repository/ike-snapshots/</url>
        </snapshotRepository>
        <!-- <site> URL for site:stage relative-path computation. Used
             by ike:site-publish; the actual content is rsync'd to the
             gh-pages branch of the org-site repo, not deployed via
             site:deploy. Inheriting projects MUST override this with
             their own <site> URL (https://ike.network/<artifactId>/),
             since the inherited template here points at ike-base-parent
             itself. -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/ike-base-parent/</url>
        </site>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Latest RELEASED ike-base-parent version. The site-resources
             profile (below, inherited by every consumer of this parent)
             depends on the classified site-theme attachment at this
             version. Maven 4's strict POM-model validator rejects
             `${project.parent.version}` in a dependency version, so we
             pin to a literal here and bump it as part of each
             ike-base-parent release. One-cycle lag is acceptable for
             theme content — it changes rarely. -->
        <ike-base-parent.version>8</ike-base-parent.version>
        <!-- Javadoc strictness — defaults align with Maven Central
             expectations. Inheriting projects can override per-module
             (e.g. ike-tooling sets failOnWarnings=true). -->
        <ike.javadoc.doclint>all,-missing</ike.javadoc.doclint>
        <ike.javadoc.failOnWarnings>false</ike.javadoc.failOnWarnings>
        <!-- Opt in to Maven Central publishing through JReleaser.
             ike-tooling, ike-docs, and ike-platform each declared
             this property locally; promote to Tier 0 so external
             standalone consumers default to Central too. Override
             with -Dike.publishToCentral=false for an internal-only
             release. -->
        <ike.publishToCentral>true</ike.publishToCentral>

        <!-- ═══════════════════════════════════════════════════════
             IKE typed-marker family: canonical version-property pins
             ═══════════════════════════════════════════════════════

             The IKE Network's canonical version registry. A version
             pin is named <groupId>__GA__<artifactId>__VERSION; a
             release policy on the same coordinate is
             <groupId>__GA__<artifactId>__POLICY. The convention's
             rule: __ is a separator between adjacent name-parts;
             trailing __ only appears when something follows; the
             XML structural terminator (> for declarations, } for
             references) closes the final segment. See
             IKE-VERSIONS.md (in ike-tooling/ike-build-standards)
             and IKE-Network/ike-issues#470, #473, #525.

             Replaced the pre-#525 U+00B7 MIDDLE DOT (·) separator
             after IntelliJ's narrower property-resolver regex was
             found to reject it. The typed-marker family stays
             inside every resolver's identifier regex while
             remaining self-documenting and greppable (e.g.
             grep -E '__VERSION[>}]').

             Inheriting projects reference any pin below as:
                 <version>${network.ike.tooling__GA__ike-tooling__VERSION}</version>
             without declaring anything locally. Legacy short-name
             aliases below provide one-line indirections so
             existing references keep working unchanged.

             The same data is shipped as the `aliases` classified
             attachment on this artifact (src/main/aliases/
             version-aliases.yaml), and bundled inside
             ike-version-management-extension for projects that
             use the extension without inheriting this parent. -->

        <!-- IKE foundation (Tier 0 / Tier 1) -->
        <network.ike__GA__ike-base-parent__VERSION>13</network.ike__GA__ike-base-parent__VERSION>
        <network.ike__GA__ike-java-support__VERSION>6</network.ike__GA__ike-java-support__VERSION>
        <network.ike.tooling__GA__ike-tooling__VERSION>214</network.ike.tooling__GA__ike-tooling__VERSION>
        <network.ike.tooling__GA__ike-workspace-extension__VERSION>7</network.ike.tooling__GA__ike-workspace-extension__VERSION>
        <network.ike.tooling__GA__ike-version-management-extension__VERSION>6</network.ike.tooling__GA__ike-version-management-extension__VERSION>
        <network.ike.docs__GA__ike-docs__VERSION>63</network.ike.docs__GA__ike-docs__VERSION>
        <network.ike.platform__GA__ike-platform__VERSION>91</network.ike.platform__GA__ike-platform__VERSION>

        <!-- ═══════════════════════════════════════════════════════
             Release-policy defaults (IKE-Network/ike-issues#498)
             ═══════════════════════════════════════════════════════

             For each canonical version pin above, a paired
             ${G__GA__A__POLICY} property declares how a consumer of
             this parent reacts when that upstream releases. The
             default `integrate` matches the historical behavior —
             bump the pin in place, no human gate. Consumers
             override per-upstream by redeclaring the property
             locally.

             The ReleasePolicy ladder (in network.ike:ike-java-support):
               notify     log only
               verify     log + verify the consumer still builds
               propose    open a proposal branch with the bump
               integrate  bump the pin (current implicit behavior)
               release    bump + trigger the consumer's own release

             ike-version-management-extension validates the value
             against the enum at build time; an unrecognized value
             fails the build with a "did you mean" hint.
             ReleasePrep.alignUpstreamProperties dispatches on the
             value at release time. -->
        <network.ike__GA__ike-base-parent__POLICY>integrate</network.ike__GA__ike-base-parent__POLICY>
        <network.ike__GA__ike-java-support__POLICY>integrate</network.ike__GA__ike-java-support__POLICY>
        <network.ike.tooling__GA__ike-tooling__POLICY>integrate</network.ike.tooling__GA__ike-tooling__POLICY>
        <network.ike.tooling__GA__ike-workspace-extension__POLICY>integrate</network.ike.tooling__GA__ike-workspace-extension__POLICY>
        <network.ike.tooling__GA__ike-version-management-extension__POLICY>integrate</network.ike.tooling__GA__ike-version-management-extension__POLICY>
        <network.ike.docs__GA__ike-docs__POLICY>integrate</network.ike.docs__GA__ike-docs__POLICY>
        <network.ike.platform__GA__ike-platform__POLICY>integrate</network.ike.platform__GA__ike-platform__POLICY>

        <!-- Test stack -->
        <org.junit.jupiter__GA__junit-jupiter__VERSION>6.0.0</org.junit.jupiter__GA__junit-jupiter__VERSION>
        <org.junit.jupiter__GA__junit-jupiter-api__VERSION>6.0.0</org.junit.jupiter__GA__junit-jupiter-api__VERSION>
        <org.junit.jupiter__GA__junit-jupiter-engine__VERSION>6.0.0</org.junit.jupiter__GA__junit-jupiter-engine__VERSION>
        <org.junit.jupiter__GA__junit-jupiter-params__VERSION>6.0.0</org.junit.jupiter__GA__junit-jupiter-params__VERSION>
        <org.junit__GA__junit-bom__VERSION>6.0.0</org.junit__GA__junit-bom__VERSION>
        <org.assertj__GA__assertj-core__VERSION>3.27.3</org.assertj__GA__assertj-core__VERSION>
        <org.mockito__GA__mockito-core__VERSION>5.14.2</org.mockito__GA__mockito-core__VERSION>
        <org.mockito__GA__mockito-junit-jupiter__VERSION>5.14.2</org.mockito__GA__mockito-junit-jupiter__VERSION>

        <!-- Collections / utilities -->
        <org.eclipse.collections__GA__eclipse-collections-api__VERSION>12.0.0</org.eclipse.collections__GA__eclipse-collections-api__VERSION>
        <org.eclipse.collections__GA__eclipse-collections__VERSION>12.0.0</org.eclipse.collections__GA__eclipse-collections__VERSION>
        <org.eclipse.collections__GA__eclipse-collections-forkjoin__VERSION>12.0.0</org.eclipse.collections__GA__eclipse-collections-forkjoin__VERSION>

        <!-- Logging -->
        <org.slf4j__GA__slf4j-api__VERSION>2.0.16</org.slf4j__GA__slf4j-api__VERSION>
        <ch.qos.logback__GA__logback-classic__VERSION>1.5.18</ch.qos.logback__GA__logback-classic__VERSION>

        <!-- Maven plugins (canonical pins; ike-parent's
             <pluginManagement> references these for the IKE
             foundation's curated plugin matrix) -->
        <org.apache.maven.plugins__GA__maven-compiler-plugin__VERSION>3.14.0</org.apache.maven.plugins__GA__maven-compiler-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-surefire-plugin__VERSION>3.5.3</org.apache.maven.plugins__GA__maven-surefire-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-failsafe-plugin__VERSION>3.5.3</org.apache.maven.plugins__GA__maven-failsafe-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-assembly-plugin__VERSION>3.7.1</org.apache.maven.plugins__GA__maven-assembly-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-dependency-plugin__VERSION>3.9.0</org.apache.maven.plugins__GA__maven-dependency-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-resources-plugin__VERSION>3.3.1</org.apache.maven.plugins__GA__maven-resources-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-source-plugin__VERSION>3.3.1</org.apache.maven.plugins__GA__maven-source-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-javadoc-plugin__VERSION>3.11.2</org.apache.maven.plugins__GA__maven-javadoc-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-gpg-plugin__VERSION>3.2.8</org.apache.maven.plugins__GA__maven-gpg-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-site-plugin__VERSION>3.21.0</org.apache.maven.plugins__GA__maven-site-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-jar-plugin__VERSION>3.4.2</org.apache.maven.plugins__GA__maven-jar-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-clean-plugin__VERSION>3.4.0</org.apache.maven.plugins__GA__maven-clean-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-install-plugin__VERSION>3.1.3</org.apache.maven.plugins__GA__maven-install-plugin__VERSION>
        <org.apache.maven.plugins__GA__maven-deploy-plugin__VERSION>3.1.3</org.apache.maven.plugins__GA__maven-deploy-plugin__VERSION>
        <org.jreleaser__GA__jreleaser-maven-plugin__VERSION>1.24.0</org.jreleaser__GA__jreleaser-maven-plugin__VERSION>

        <!-- ═══════════════════════════════════════════════════════
             Legacy short-name aliases (one-line indirections)
             ═══════════════════════════════════════════════════════

             Consumers that use the wider-ecosystem short-name
             idioms (junit-jupiter.version, maven-compiler-plugin.
             version, etc.) keep working unchanged: each alias
             indirects to its canonical typed-marker pin above.
             Removing an alias is a future deprecation cycle, not
             part of this release. -->

        <!-- IKE foundation legacy short names -->
        <ike-tooling.version>${network.ike.tooling__GA__ike-tooling__VERSION}</ike-tooling.version>
        <ike-workspace-extension.version>${network.ike.tooling__GA__ike-workspace-extension__VERSION}</ike-workspace-extension.version>
        <ike-version-management-extension.version>${network.ike.tooling__GA__ike-version-management-extension__VERSION}</ike-version-management-extension.version>
        <ike-java-support.version>${network.ike__GA__ike-java-support__VERSION}</ike-java-support.version>
        <ike-docs.version>${network.ike.docs__GA__ike-docs__VERSION}</ike-docs.version>
        <ike-platform.version>${network.ike.platform__GA__ike-platform__VERSION}</ike-platform.version>

        <!-- Test stack legacy short names -->
        <junit-jupiter.version>${org.junit.jupiter__GA__junit-jupiter__VERSION}</junit-jupiter.version>
        <junit.version>${org.junit.jupiter__GA__junit-jupiter__VERSION}</junit.version>
        <assertj.version>${org.assertj__GA__assertj-core__VERSION}</assertj.version>
        <mockito.version>${org.mockito__GA__mockito-core__VERSION}</mockito.version>

        <!-- Collections / utilities legacy short names -->
        <eclipse-collections.version>${org.eclipse.collections__GA__eclipse-collections__VERSION}</eclipse-collections.version>
        <eclipse-collections-api.version>${org.eclipse.collections__GA__eclipse-collections-api__VERSION}</eclipse-collections-api.version>

        <!-- Logging legacy short names -->
        <slf4j.version>${org.slf4j__GA__slf4j-api__VERSION}</slf4j.version>
        <logback.version>${ch.qos.logback__GA__logback-classic__VERSION}</logback.version>

        <!-- Maven plugins legacy short names. Every Maven-plugin
             canonical pin above gets a one-line indirection here
             so existing references in this POM and downstream
             consumers continue to resolve. -->
        <maven-compiler-plugin.version>${org.apache.maven.plugins__GA__maven-compiler-plugin__VERSION}</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>${org.apache.maven.plugins__GA__maven-surefire-plugin__VERSION}</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>${org.apache.maven.plugins__GA__maven-failsafe-plugin__VERSION}</maven-failsafe-plugin.version>
        <maven-assembly-plugin.version>${org.apache.maven.plugins__GA__maven-assembly-plugin__VERSION}</maven-assembly-plugin.version>
        <maven-dependency-plugin.version>${org.apache.maven.plugins__GA__maven-dependency-plugin__VERSION}</maven-dependency-plugin.version>
        <maven-resources-plugin.version>${org.apache.maven.plugins__GA__maven-resources-plugin__VERSION}</maven-resources-plugin.version>
        <maven-source-plugin.version>${org.apache.maven.plugins__GA__maven-source-plugin__VERSION}</maven-source-plugin.version>
        <maven-javadoc-plugin.version>${org.apache.maven.plugins__GA__maven-javadoc-plugin__VERSION}</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>${org.apache.maven.plugins__GA__maven-gpg-plugin__VERSION}</maven-gpg-plugin.version>
        <maven-site-plugin.version>${org.apache.maven.plugins__GA__maven-site-plugin__VERSION}</maven-site-plugin.version>
        <jreleaser-maven-plugin.version>${org.jreleaser__GA__jreleaser-maven-plugin__VERSION}</jreleaser-maven-plugin.version>
    </properties>

    <build>
        <!-- ════════════════════════════════════════════════════════════════
             Plugin Management — version pins and default config (#523)
             ════════════════════════════════════════════════════════════════

             Principle: version pinning belongs in <pluginManagement>;
             execution binding belongs in <build><plugins>. Never both
             in the same element. Mixing them in active <plugins> with
             plugin-level <inherited>false</inherited> conflates two
             separate intents and drops the version pin alongside the
             executions for descendants.

             <pluginManagement> is declarative and propagates to every
             descendant's effective POM regardless of <inherited>
             markers; <build><plugins> activates plugin executions in
             the current project. For parent-only executions, use
             plugin-level or execution-level <inherited>false</inherited>
             on the active entry — the version pin is unaffected
             because it lives here. -->
        <pluginManagement>
            <plugins>
                <!-- maven-assembly-plugin: version pin. The active
                     entry in <build><plugins> below activates the
                     parent-only site-theme and aliases executions
                     (<inherited>false</inherited>). Descendants that
                     use maven-assembly-plugin for their own purposes
                     pick up this version via pluginManagement
                     inheritance. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>

                <!-- maven-resources-plugin: version pin. The active
                     entry below runs the parent-only
                     copy-own-site-theme execution. Descendants that
                     need maven-resources-plugin pick up this version
                     via pluginManagement inheritance. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>

                <!-- Maven Site — renders src/site/asciidoc/ into the
                     project's published site. Doxia AsciiDoctor module
                     + Sentry skin tools + GraalVM polyglot dependencies
                     live here so every descendant invoking site:site
                     picks up the same skin/parser stack via
                     pluginManagement inheritance. No active <plugins>
                     entry needed because site:site is invoked
                     explicitly, not phase-bound. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.sentrysoftware.maven</groupId>
                            <artifactId>maven-skin-tools</artifactId>
                            <version>1.7.00</version>
                            <exclusions>
                                <exclusion>
                                    <groupId>org.graalvm.js</groupId>
                                    <artifactId>js</artifactId>
                                </exclusion>
                            </exclusions>
                        </dependency>
                        <dependency>
                            <groupId>org.graalvm.polyglot</groupId>
                            <artifactId>polyglot</artifactId>
                            <version>25.0.2</version>
                        </dependency>
                        <dependency>
                            <groupId>org.graalvm.polyglot</groupId>
                            <artifactId>js</artifactId>
                            <version>25.0.2</version>
                            <type>pom</type>
                        </dependency>
                        <dependency>
                            <groupId>org.asciidoctor</groupId>
                            <artifactId>asciidoctor-parser-doxia-module</artifactId>
                            <version>3.2.0</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- JReleaser — Maven Central upload. Invoked as an
                     explicit goal (mvn jreleaser:deploy), never bound
                     to a lifecycle phase. <configuration> here is
                     inherited by every IKE artifact that inherits
                     ike-base-parent via pluginManagement.

                     Release is two-step:
                       1. mvn deploy -PsignArtifacts \
                            -DaltDeploymentRepository=local::file://target/staging-deploy
                          writes signed artifacts to target/staging-deploy
                       2. mvn jreleaser:deploy
                          uploads that bundle to the Central Portal
                     Credentials: JRELEASER_DEPLOY_MAVEN_MAVENCENTRAL_USERNAME /
                     _PASSWORD env vars, supplied via `op run`. -->
                <plugin>
                    <groupId>org.jreleaser</groupId>
                    <artifactId>jreleaser-maven-plugin</artifactId>
                    <version>${jreleaser-maven-plugin.version}</version>
                    <configuration>
                        <jreleaser>
                            <!-- Artifacts are signed by maven-gpg-plugin
                                 (Bouncy Castle) during the staging deploy;
                                 JReleaser does not re-sign. -->
                            <signing>
                                <active>NEVER</active>
                            </signing>
                            <deploy>
                                <maven>
                                    <mavenCentral>
                                        <sonatype>
                                            <active>RELEASE</active>
                                            <url>https://central.sonatype.com/api/v1/publisher</url>
                                            <stagingRepositories>
                                                <stagingRepository>target/staging-deploy</stagingRepository>
                                            </stagingRepositories>
                                            <applyMavenCentralRules>true</applyMavenCentralRules>
                                            <!-- Artifacts arrive pre-signed (BC);
                                                 do not let the Central rules
                                                 re-sign them. -->
                                            <sign>false</sign>
                                        </sonatype>
                                    </mavenCentral>
                                </maven>
                            </deploy>
                        </jreleaser>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- ════════════════════════════════════════════════════════════════
             Active Plugins — executions only, no version pinning (#523)
             ════════════════════════════════════════════════════════════════

             Only plugins with parent-bound executions appear here. Each
             entry references the plugin by GAV (no <version> — inherits
             from pluginManagement). Plugin-level
             <inherited>false</inherited> is set when every execution is
             parent-only — no point cluttering descendants' effective
             POMs with a dead active entry — and is now safe because
             the version pin lives in pluginManagement above. -->
        <plugins>
            <!-- maven-assembly-plugin: parent-only executions. Produces
                 the canonical IKE Forest site-theme + aliases manifest
                 as classified attachments on ike-base-parent itself.
                 Descriptors (src/assembly/site-theme.xml,
                 src/assembly/aliases.xml) and the source content
                 (src/main/site-theme/) live only in this repo.

                 Replaces ike-tooling/ike-build-standards:site-theme.
                 The old artifact stays one cycle for back-compat
                 (see #464). Putting this in Tier 0 eliminates the
                 Tier 0 → Tier 1 dep that ike-workspace-extension
                 and ike-base-parent's own site-resources workaround
                 used to need. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>site-theme</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/site-theme.xml</descriptor>
                            </descriptors>
                            <attach>true</attach>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                    <!-- aliases: the IKE typed-marker family default
                         manifest, shipped as a classified zip so
                         external tooling can consume it as data
                         without depending on
                         ike-version-management-extension. See
                         IKE-Network/ike-issues#470, #473, #525. -->
                    <execution>
                        <id>aliases</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/aliases.xml</descriptor>
                            </descriptors>
                            <attach>true</attach>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-resources-plugin: parent-only execution.
                 Copies ike-base-parent's OWN site-theme content
                 into its OWN site at pre-site. The site-resources
                 profile below depends on the classified-zip
                 attachment to populate inheriting projects' sites,
                 but ike-base-parent itself can't depend on its
                 own un-released SNAPSHOT artifact —
                 chicken-and-egg. Inlining the file copy here
                 cuts the loop. Children get the same content via
                 the site-resources profile's classified-zip
                 unpack. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>copy-own-site-theme</id>
                        <phase>pre-site</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-site/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/site-theme</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ── site-resources ───────────────────────────────────────── -->
        <!-- File-activated when src/site exists AND src/main/site-theme
             does NOT (i.e., the consuming project doesn't ship its own
             theme source). Unpacks ike-base-parent's classified
             site-theme attachment into target/generated-site/resources/
             at pre-site, which Maven Site merges into target/site at
             site:site time.

             ike-base-parent itself DOES have src/main/site-theme/ —
             so this profile doesn't fire for ike-base-parent's own
             build, sidestepping the self-reference SNAPSHOT
             resolution problem. ike-base-parent's own theme is
             copied by the inherited=false maven-resources-plugin
             execution in <build><plugins> above.

             Every IKE-inheriting project that has src/site gets the
             theme automatically: ike-tooling/ike-docs/ike-platform
             (Tier 1), ike-workspace-extension, the workspace
             aggregators, and the example templates. No per-project
             workaround needed (#464). -->
        <profile>
            <id>site-resources</id>
            <activation>
                <!-- Activated when the consuming project does NOT ship
                     its own site-theme source. ike-base-parent itself
                     has src/main/site-theme/ (the canonical content);
                     every other consumer doesn't, so this profile
                     fires for them. Maven 4 honors only one of
                     <exists>/<missing> in a single <file> activation,
                     so we gate on the more selective one. The
                     unpack-dependencies execution runs at pre-site
                     and is a no-op when src/site is absent. -->
                <file>
                    <missing>src/main/site-theme</missing>
                </file>
            </activation>

            <dependencies>
                <!-- The classified site-theme zip lives on Maven
                     Central at the most-recently-released
                     ike-base-parent version (literal in the
                     ${ike-base-parent.version} property above).
                     Bumped per release; theme content rarely
                     changes so one-cycle lag is acceptable. -->
                <dependency>
                    <groupId>network.ike</groupId>
                    <artifactId>ike-base-parent</artifactId>
                    <version>${ike-base-parent.version}</version>
                    <classifier>site-theme</classifier>
                    <type>zip</type>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${maven-dependency-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>unpack-site-theme</id>
                                <phase>pre-site</phase>
                                <goals><goal>unpack-dependencies</goal></goals>
                                <configuration>
                                    <includeGroupIds>network.ike</includeGroupIds>
                                    <includeArtifactIds>ike-base-parent</includeArtifactIds>
                                    <includeClassifiers>site-theme</includeClassifiers>
                                    <includeTypes>zip</includeTypes>
                                    <outputDirectory>${project.build.directory}/generated-site/resources</outputDirectory>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Artifact signing for release / staging deploys. Bouncy Castle
             signer — parallel-safe, no gpg-agent contention. Reads the key
             from gpg.keyFilePath (settings.xml) and the passphrase from
             MAVEN_GPG_PASSPHRASE (supplied via `op run`). Activate with
             -PsignArtifacts on the staging deploy. -->
        <profile>
            <id>signArtifacts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Release profile: attach sources + javadoc jars, required by
             Maven Central. Used by ike:release-publish (`mvn deploy -P
             release,signArtifacts`). Previously duplicated in each
             Tier-1 reactor root (ike-tooling, ike-docs, ike-platform);
             promoted to Tier 0 here so external standalone consumers
             (ike-workspace-extension, future siblings) get it via
             inheritance instead of having to redeclare it.
             See IKE-Network/ike-issues#461. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>${ike.javadoc.doclint}</doclint>
                            <failOnWarnings>${ike.javadoc.failOnWarnings}</failOnWarnings>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
