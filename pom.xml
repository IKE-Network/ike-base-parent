<?xml version="1.0" encoding="UTF-8"?>
<!--
  IKE Base Parent — Tier 0
  ════════════════════════

  The foundation parent for the IKE Network: the apex of the parent
  inheritance forest, inherited by ike-tooling, ike-docs, and
  ike-platform. It carries shared publishing metadata; GPG signing
  and Maven Central (JReleaser) configuration are added next, and
  build conventions migrate in incrementally.

  See the design note dev-parent-tier-architecture (ike-lab-documents)
  for the tier model and the staged migration plan.
-->
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0
         http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <groupId>network.ike</groupId>
    <artifactId>ike-base-parent</artifactId>
    <version>12-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Base Parent</name>
    <description>
        Tier 0 foundation parent for the IKE Network — the apex of the
        parent inheritance forest, inherited by ike-tooling, ike-docs,
        and ike-platform. Carries shared publishing metadata, GPG
        signing, and Maven Central publishing configuration.
    </description>
    <url>https://ike.network/ike-base-parent/</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>IKE Network</name>
        <url>https://ike.network</url>
    </organization>

    <developers>
        <developer>
            <name>IKE Network Team</name>
            <email>dev@ike.network</email>
            <organization>IKE Network</organization>
            <organizationUrl>https://ike.network</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/IKE-Network/ike-base-parent.git</connection>
        <developerConnection>scm:git:git@github.com:IKE-Network/ike-base-parent.git</developerConnection>
        <url>https://github.com/IKE-Network/ike-base-parent</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <!-- Releases go to Maven Central via JReleaser (jreleaser-maven-plugin
             config below). This <repository> is the internal Nexus mirror
             — used by `mvn deploy -P release` as a parallel publication
             target. The Central upload runs through JReleaser separately. -->
        <repository>
            <id>ike-staging</id>
            <url>https://nexus.tinkar.org/repository/ike-staging/</url>
        </repository>
        <snapshotRepository>
            <id>ike-snapshots</id>
            <url>https://nexus.tinkar.org/repository/ike-snapshots/</url>
        </snapshotRepository>
        <!-- <site> URL for site:stage relative-path computation. Used
             by ike:site-publish; the actual content is rsync'd to the
             gh-pages branch of the org-site repo, not deployed via
             site:deploy. Inheriting projects MUST override this with
             their own <site> URL (https://ike.network/<artifactId>/),
             since the inherited template here points at ike-base-parent
             itself. -->
        <site>
            <id>ike-site</id>
            <url>https://ike.network/ike-base-parent/</url>
        </site>
    </distributionManagement>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Latest RELEASED ike-base-parent version. The site-resources
             profile (below, inherited by every consumer of this parent)
             depends on the classified site-theme attachment at this
             version. Maven 4's strict POM-model validator rejects
             `${project.parent.version}` in a dependency version, so we
             pin to a literal here and bump it as part of each
             ike-base-parent release. One-cycle lag is acceptable for
             theme content — it changes rarely. -->
        <ike-base-parent.version>8</ike-base-parent.version>
        <!-- Javadoc strictness — defaults align with Maven Central
             expectations. Inheriting projects can override per-module
             (e.g. ike-tooling sets failOnWarnings=true). -->
        <ike.javadoc.doclint>all,-missing</ike.javadoc.doclint>
        <ike.javadoc.failOnWarnings>false</ike.javadoc.failOnWarnings>
        <!-- Opt in to Maven Central publishing through JReleaser.
             ike-tooling, ike-docs, and ike-platform each declared
             this property locally; promote to Tier 0 so external
             standalone consumers default to Central too. Override
             with -Dike.publishToCentral=false for an internal-only
             release. -->
        <ike.publishToCentral>true</ike.publishToCentral>

        <!-- ═══════════════════════════════════════════════════════
             IKE GA·convention: canonical version-property pins
             ═══════════════════════════════════════════════════════

             The IKE Network's canonical version registry. Property
             name is groupId·artifactId (U+00B7 MIDDLE DOT); value
             is the version. See IKE-VERSIONS.md (in ike-tooling/
             ike-build-standards) and IKE-Network/ike-issues#470,
             #473.

             Inheriting projects reference any pin below as:
                 <version>${network.ike.tooling·ike-tooling}</version>
             without declaring anything locally. Legacy short-name
             aliases below provide one-line indirections so
             existing references keep working unchanged.

             The same data is shipped as the `aliases` classified
             attachment on this artifact (src/main/aliases/
             version-aliases.yaml), and bundled inside
             ike-version-management-extension for projects that
             use the extension without inheriting this parent. -->

        <!-- IKE foundation (Tier 0 / Tier 1) -->
        <network.ike·ike-base-parent>9</network.ike·ike-base-parent>
        <network.ike·ike-java-support>4</network.ike·ike-java-support>
        <network.ike.tooling·ike-tooling>211</network.ike.tooling·ike-tooling>
        <network.ike.tooling·ike-workspace-extension>6</network.ike.tooling·ike-workspace-extension>
        <network.ike.tooling·ike-version-management-extension>4</network.ike.tooling·ike-version-management-extension>
        <network.ike.docs·ike-docs>61</network.ike.docs·ike-docs>
        <network.ike.platform·ike-platform>89</network.ike.platform·ike-platform>

        <!-- ═══════════════════════════════════════════════════════
             Release-policy defaults (IKE-Network/ike-issues#498)
             ═══════════════════════════════════════════════════════

             For each canonical version pin above, a paired
             ${G·A·policy} property declares how a consumer of this
             parent reacts when that upstream releases. The default
             `integrate` matches the historical behavior — bump the
             pin in place, no human gate. Consumers override per-
             upstream by redeclaring the property locally.

             The ReleasePolicy ladder (in network.ike:ike-java-support):
               notify     log only
               verify     log + verify the consumer still builds
               propose    open a proposal branch with the bump
               integrate  bump the pin (current implicit behavior)
               release    bump + trigger the consumer's own release

             ike-version-management-extension validates the value
             against the enum at build time; an unrecognized value
             fails the build with a "did you mean" hint.
             ReleasePrep.alignUpstreamProperties dispatches on the
             value at release time. -->
        <network.ike·ike-base-parent·policy>integrate</network.ike·ike-base-parent·policy>
        <network.ike·ike-java-support·policy>integrate</network.ike·ike-java-support·policy>
        <network.ike.tooling·ike-tooling·policy>integrate</network.ike.tooling·ike-tooling·policy>
        <network.ike.tooling·ike-workspace-extension·policy>integrate</network.ike.tooling·ike-workspace-extension·policy>
        <network.ike.tooling·ike-version-management-extension·policy>integrate</network.ike.tooling·ike-version-management-extension·policy>
        <network.ike.docs·ike-docs·policy>integrate</network.ike.docs·ike-docs·policy>
        <network.ike.platform·ike-platform·policy>integrate</network.ike.platform·ike-platform·policy>

        <!-- Test stack -->
        <org.junit.jupiter·junit-jupiter>6.0.0</org.junit.jupiter·junit-jupiter>
        <org.junit.jupiter·junit-jupiter-api>6.0.0</org.junit.jupiter·junit-jupiter-api>
        <org.junit.jupiter·junit-jupiter-engine>6.0.0</org.junit.jupiter·junit-jupiter-engine>
        <org.junit.jupiter·junit-jupiter-params>6.0.0</org.junit.jupiter·junit-jupiter-params>
        <org.junit·junit-bom>6.0.0</org.junit·junit-bom>
        <org.assertj·assertj-core>3.27.3</org.assertj·assertj-core>
        <org.mockito·mockito-core>5.14.2</org.mockito·mockito-core>
        <org.mockito·mockito-junit-jupiter>5.14.2</org.mockito·mockito-junit-jupiter>

        <!-- Collections / utilities -->
        <org.eclipse.collections·eclipse-collections-api>12.0.0</org.eclipse.collections·eclipse-collections-api>
        <org.eclipse.collections·eclipse-collections>12.0.0</org.eclipse.collections·eclipse-collections>
        <org.eclipse.collections·eclipse-collections-forkjoin>12.0.0</org.eclipse.collections·eclipse-collections-forkjoin>

        <!-- Logging -->
        <org.slf4j·slf4j-api>2.0.16</org.slf4j·slf4j-api>
        <ch.qos.logback·logback-classic>1.5.18</ch.qos.logback·logback-classic>

        <!-- Maven plugins (canonical pins; ike-parent's
             <pluginManagement> references these for the IKE
             foundation's curated plugin matrix) -->
        <org.apache.maven.plugins·maven-compiler-plugin>3.14.0</org.apache.maven.plugins·maven-compiler-plugin>
        <org.apache.maven.plugins·maven-surefire-plugin>3.5.3</org.apache.maven.plugins·maven-surefire-plugin>
        <org.apache.maven.plugins·maven-failsafe-plugin>3.5.3</org.apache.maven.plugins·maven-failsafe-plugin>
        <org.apache.maven.plugins·maven-assembly-plugin>3.7.1</org.apache.maven.plugins·maven-assembly-plugin>
        <org.apache.maven.plugins·maven-dependency-plugin>3.9.0</org.apache.maven.plugins·maven-dependency-plugin>
        <org.apache.maven.plugins·maven-resources-plugin>3.3.1</org.apache.maven.plugins·maven-resources-plugin>
        <org.apache.maven.plugins·maven-source-plugin>3.3.1</org.apache.maven.plugins·maven-source-plugin>
        <org.apache.maven.plugins·maven-javadoc-plugin>3.11.2</org.apache.maven.plugins·maven-javadoc-plugin>
        <org.apache.maven.plugins·maven-gpg-plugin>3.2.8</org.apache.maven.plugins·maven-gpg-plugin>
        <org.apache.maven.plugins·maven-site-plugin>3.21.0</org.apache.maven.plugins·maven-site-plugin>
        <org.apache.maven.plugins·maven-jar-plugin>3.4.2</org.apache.maven.plugins·maven-jar-plugin>
        <org.apache.maven.plugins·maven-clean-plugin>3.4.0</org.apache.maven.plugins·maven-clean-plugin>
        <org.apache.maven.plugins·maven-install-plugin>3.1.3</org.apache.maven.plugins·maven-install-plugin>
        <org.apache.maven.plugins·maven-deploy-plugin>3.1.3</org.apache.maven.plugins·maven-deploy-plugin>
        <org.jreleaser·jreleaser-maven-plugin>1.24.0</org.jreleaser·jreleaser-maven-plugin>

        <!-- ═══════════════════════════════════════════════════════
             Legacy short-name aliases (one-line indirections)
             ═══════════════════════════════════════════════════════

             Consumers that use the wider-ecosystem short-name
             idioms (junit-jupiter.version, maven-compiler-plugin.
             version, etc.) keep working unchanged: each alias
             indirects to its canonical ${G·A} pin above. Removing
             an alias is a future deprecation cycle, not part of
             this release. -->

        <!-- IKE foundation legacy short names -->
        <ike-tooling.version>${network.ike.tooling·ike-tooling}</ike-tooling.version>
        <ike-workspace-extension.version>${network.ike.tooling·ike-workspace-extension}</ike-workspace-extension.version>
        <ike-version-management-extension.version>${network.ike.tooling·ike-version-management-extension}</ike-version-management-extension.version>
        <ike-java-support.version>${network.ike·ike-java-support}</ike-java-support.version>
        <ike-docs.version>${network.ike.docs·ike-docs}</ike-docs.version>
        <ike-platform.version>${network.ike.platform·ike-platform}</ike-platform.version>

        <!-- Test stack legacy short names -->
        <junit-jupiter.version>${org.junit.jupiter·junit-jupiter}</junit-jupiter.version>
        <junit.version>${org.junit.jupiter·junit-jupiter}</junit.version>
        <assertj.version>${org.assertj·assertj-core}</assertj.version>
        <mockito.version>${org.mockito·mockito-core}</mockito.version>

        <!-- Collections / utilities legacy short names -->
        <eclipse-collections.version>${org.eclipse.collections·eclipse-collections}</eclipse-collections.version>
        <eclipse-collections-api.version>${org.eclipse.collections·eclipse-collections-api}</eclipse-collections-api.version>

        <!-- Logging legacy short names -->
        <slf4j.version>${org.slf4j·slf4j-api}</slf4j.version>
        <logback.version>${ch.qos.logback·logback-classic}</logback.version>

        <!-- Maven plugins legacy short names. Every Maven-plugin
             canonical pin above gets a one-line indirection here
             so existing references in this POM and downstream
             consumers continue to resolve. -->
        <maven-compiler-plugin.version>${org.apache.maven.plugins·maven-compiler-plugin}</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>${org.apache.maven.plugins·maven-surefire-plugin}</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>${org.apache.maven.plugins·maven-failsafe-plugin}</maven-failsafe-plugin.version>
        <maven-assembly-plugin.version>${org.apache.maven.plugins·maven-assembly-plugin}</maven-assembly-plugin.version>
        <maven-dependency-plugin.version>${org.apache.maven.plugins·maven-dependency-plugin}</maven-dependency-plugin.version>
        <maven-resources-plugin.version>${org.apache.maven.plugins·maven-resources-plugin}</maven-resources-plugin.version>
        <maven-source-plugin.version>${org.apache.maven.plugins·maven-source-plugin}</maven-source-plugin.version>
        <maven-javadoc-plugin.version>${org.apache.maven.plugins·maven-javadoc-plugin}</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>${org.apache.maven.plugins·maven-gpg-plugin}</maven-gpg-plugin.version>
        <maven-site-plugin.version>${org.apache.maven.plugins·maven-site-plugin}</maven-site-plugin.version>
        <jreleaser-maven-plugin.version>${org.jreleaser·jreleaser-maven-plugin}</jreleaser-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <!-- maven-assembly-plugin: produce the canonical IKE Forest
                 site-theme as a classified attachment on ike-base-parent
                 itself. The descriptor (src/assembly/site-theme.xml) and
                 the source content (src/main/site-theme/) live only in
                 this repo — `<inherited>false</inherited>` keeps every
                 child from attempting to build its own copy.

                 Replaces ike-tooling/ike-build-standards:site-theme. The
                 old artifact stays one cycle for back-compat (see #464).
                 Putting this in Tier 0 eliminates the Tier 0 → Tier 1
                 dep that ike-workspace-extension and ike-base-parent's
                 own site-resources workaround used to need. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>site-theme</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/site-theme.xml</descriptor>
                            </descriptors>
                            <attach>true</attach>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                    <!-- aliases: the IKE GA·convention default
                         manifest, shipped as a classified zip so
                         external tooling can consume it as data
                         without depending on
                         ike-version-management-extension. See
                         IKE-Network/ike-issues#470, #473. -->
                    <execution>
                        <id>aliases</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/aliases.xml</descriptor>
                            </descriptors>
                            <attach>true</attach>
                            <appendAssemblyId>true</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- maven-resources-plugin: copy ike-base-parent's OWN
                 site-theme content into its OWN site at pre-site.
                 The site-resources profile below depends on the
                 classified-zip attachment to populate inheriting
                 projects' sites, but ike-base-parent itself can't
                 depend on its own un-released SNAPSHOT artifact —
                 chicken-and-egg. Inlining the file copy here cuts
                 the loop.

                 `<inherited>false</inherited>`: only runs for
                 ike-base-parent's own site build. Children get the
                 same content via the site-resources profile's
                 classified-zip unpack. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>copy-own-site-theme</id>
                        <phase>pre-site</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/generated-site/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/site-theme</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Site — renders src/site/asciidoc/ into the project's
                 published site. Lightweight: just enough to build the
                 one-page Tier 0 site, no ike: release machinery. -->
            <plugin>
                <artifactId>maven-site-plugin</artifactId>
                <version>3.21.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.sentrysoftware.maven</groupId>
                        <artifactId>maven-skin-tools</artifactId>
                        <version>1.7.00</version>
                        <exclusions>
                            <exclusion>
                                <groupId>org.graalvm.js</groupId>
                                <artifactId>js</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                    <dependency>
                        <groupId>org.graalvm.polyglot</groupId>
                        <artifactId>polyglot</artifactId>
                        <version>25.0.2</version>
                    </dependency>
                    <dependency>
                        <groupId>org.graalvm.polyglot</groupId>
                        <artifactId>js</artifactId>
                        <version>25.0.2</version>
                        <type>pom</type>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctor-parser-doxia-module</artifactId>
                        <version>3.2.0</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- JReleaser — Maven Central upload. Invoked as an explicit goal
                 (mvn jreleaser:deploy), never bound to a lifecycle phase. This
                 <configuration> is inherited by every IKE artifact that
                 inherits ike-base-parent.

                 Release is two-step:
                   1. mvn deploy -PsignArtifacts \
                        -DaltDeploymentRepository=local::file://target/staging-deploy
                      writes signed artifacts to target/staging-deploy
                   2. mvn jreleaser:deploy
                      uploads that bundle to the Central Portal
                 Credentials: JRELEASER_DEPLOY_MAVEN_MAVENCENTRAL_USERNAME /
                 _PASSWORD env vars, supplied via `op run`. -->
            <plugin>
                <groupId>org.jreleaser</groupId>
                <artifactId>jreleaser-maven-plugin</artifactId>
                <version>${jreleaser-maven-plugin.version}</version>
                <configuration>
                    <jreleaser>
                        <!-- Artifacts are signed by maven-gpg-plugin (Bouncy
                             Castle) during the staging deploy; JReleaser does
                             not re-sign. -->
                        <signing>
                            <active>NEVER</active>
                        </signing>
                        <deploy>
                            <maven>
                                <mavenCentral>
                                    <sonatype>
                                        <active>RELEASE</active>
                                        <url>https://central.sonatype.com/api/v1/publisher</url>
                                        <stagingRepositories>
                                            <stagingRepository>target/staging-deploy</stagingRepository>
                                        </stagingRepositories>
                                        <applyMavenCentralRules>true</applyMavenCentralRules>
                                        <!-- Artifacts arrive pre-signed (BC);
                                             do not let the Central rules
                                             re-sign them. -->
                                        <sign>false</sign>
                                    </sonatype>
                                </mavenCentral>
                            </maven>
                        </deploy>
                    </jreleaser>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ── site-resources ───────────────────────────────────────── -->
        <!-- File-activated when src/site exists AND src/main/site-theme
             does NOT (i.e., the consuming project doesn't ship its own
             theme source). Unpacks ike-base-parent's classified
             site-theme attachment into target/generated-site/resources/
             at pre-site, which Maven Site merges into target/site at
             site:site time.

             ike-base-parent itself DOES have src/main/site-theme/ —
             so this profile doesn't fire for ike-base-parent's own
             build, sidestepping the self-reference SNAPSHOT
             resolution problem. ike-base-parent's own theme is
             copied by the inherited=false maven-resources-plugin
             execution in <build><plugins> above.

             Every IKE-inheriting project that has src/site gets the
             theme automatically: ike-tooling/ike-docs/ike-platform
             (Tier 1), ike-workspace-extension, the workspace
             aggregators, and the example templates. No per-project
             workaround needed (#464). -->
        <profile>
            <id>site-resources</id>
            <activation>
                <!-- Activated when the consuming project does NOT ship
                     its own site-theme source. ike-base-parent itself
                     has src/main/site-theme/ (the canonical content);
                     every other consumer doesn't, so this profile
                     fires for them. Maven 4 honors only one of
                     <exists>/<missing> in a single <file> activation,
                     so we gate on the more selective one. The
                     unpack-dependencies execution runs at pre-site
                     and is a no-op when src/site is absent. -->
                <file>
                    <missing>src/main/site-theme</missing>
                </file>
            </activation>

            <dependencies>
                <!-- The classified site-theme zip lives on Maven
                     Central at the most-recently-released
                     ike-base-parent version (literal in the
                     ${ike-base-parent.version} property above).
                     Bumped per release; theme content rarely
                     changes so one-cycle lag is acceptable. -->
                <dependency>
                    <groupId>network.ike</groupId>
                    <artifactId>ike-base-parent</artifactId>
                    <version>${ike-base-parent.version}</version>
                    <classifier>site-theme</classifier>
                    <type>zip</type>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${maven-dependency-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>unpack-site-theme</id>
                                <phase>pre-site</phase>
                                <goals><goal>unpack-dependencies</goal></goals>
                                <configuration>
                                    <includeGroupIds>network.ike</includeGroupIds>
                                    <includeArtifactIds>ike-base-parent</includeArtifactIds>
                                    <includeClassifiers>site-theme</includeClassifiers>
                                    <includeTypes>zip</includeTypes>
                                    <outputDirectory>${project.build.directory}/generated-site/resources</outputDirectory>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Artifact signing for release / staging deploys. Bouncy Castle
             signer — parallel-safe, no gpg-agent contention. Reads the key
             from gpg.keyFilePath (settings.xml) and the passphrase from
             MAVEN_GPG_PASSPHRASE (supplied via `op run`). Activate with
             -PsignArtifacts on the staging deploy. -->
        <profile>
            <id>signArtifacts</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Release profile: attach sources + javadoc jars, required by
             Maven Central. Used by ike:release-publish (`mvn deploy -P
             release,signArtifacts`). Previously duplicated in each
             Tier-1 reactor root (ike-tooling, ike-docs, ike-platform);
             promoted to Tier 0 here so external standalone consumers
             (ike-workspace-extension, future siblings) get it via
             inheritance instead of having to redeclare it.
             See IKE-Network/ike-issues#461. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
